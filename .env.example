# =====================================================================
# INNOVARY MÍDIA - GERADOR DE CARROSSÉIS MULTI-AGENTE
# =====================================================================

# 1. GOOGLE GEMINI API (Opcional se usar os presets inteligentes integrados)
# Obtenha sua chave gratuita em: https://aistudio.google.com/
NEXT_PUBLIC_GEMINI_API_KEY=
GEMINI_API_KEY=

# 2. SUPABASE (Opcional no início - se vazio, utiliza armazenamento local)
# Obtenha no Dashboard do Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. META / INSTAGRAM GRAPH API (Futuro - para postagem automática)
# Deixe vazio por enquanto para validação e download manual!
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=

# 4. CONFIGURAÇÕES DA MARCA
NEXT_PUBLIC_BRAND_HANDLE=@innovarymidia
NEXT_PUBLIC_BRAND_NAME="Innovary Mídia"
NEXT_PUBLIC_BRAND_URL="https://www.innovarymidia.com.br"
